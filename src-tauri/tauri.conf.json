{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rytm-builder",
  "version": "0.1.0",
  "identifier": "com.johnny.rytm-builder",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rytm-builder",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/templates/Untitled-4.syx": "Untitled-4.syx"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "category": "Music",
    "shortDescription": "Compose Analog Rytm pattern and kit .syx files",
    "longDescription": "Browse a library of Analog Rytm whole-project dumps, stage PAT+KIT / KIT / PAT changes, and download a fresh project or differential .syx. No USB send."
  }
}
